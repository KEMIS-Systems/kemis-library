{
  "name": "kemis-library",
  "version": "2.13.75",
  "description": "Kemis package for creating forms, which mainly uses the 'primereact' library.",
  "homepage": "https://github.com/KEMIS-Systems/components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./styles": "./dist/styles/base.css",
    "./styles/components": "./dist/styles/components.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web:dev": "npx postcss src/styles/components/components.css --dir web/src/styles & npx tailwindcss -i ./web/src/styles/index.css -o ./web/src/styles/global/index.css & vite",
    "web:build": "vite build",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "postcss src/styles/components/components.css --dir dist/styles && tailwindcss -i ./src/styles/index.css -o ./dist/styles/base.css",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "version": "git add package.json && git commit -m 'Bump version'",
    "merge": "git pull && git push origin v2:master && git checkout master && git pull && git checkout v2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KEMIS-Systems/components.git"
  },
  "keywords": [
    "react",
    "components",
    "kemis",
    "form"
  ],
  "author": "KEMIS Softwware House | wmachado@kemis.com.br",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^3.2.0",
    "caniuse-lite": "^1.0.30001767",
    "file-saver": "^2.0.5",
    "next": "^13.4.4",
    "primereact": "^9.2.2",
    "quill": "^1.3.7",
    "react-icons": "^5.5.0",
    "react-image-crop": "^10.0.11",
    "react-international-phone": "^4.3.0",
    "styled-components": "^5.3.10",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.1.3",
    "webfontloader": "^1.6.28",
    "zod": "^3.22.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom-global": "^3.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.5",
    "@types/react-canvas-draw": "^1.2.0",
    "@types/styled-components": "^5.1.26",
    "@types/webfontloader": "^1.6.35",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "axios": "^1.4.0",
    "axios-mock-adapter": "^1.21.4",
    "cep-promise": "^4.4.0",
    "cpf-cnpj-validator": "^1.0.3",
    "cssnano": "^7.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "3.8.3",
    "react-canvas-draw": "^1.2.1",
    "react-cropper": "^2.3.3",
    "react-dropzone": "^14.2.2",
    "react-hook-form": "^7.34.0",
    "react-router-dom": "^6.30.1",
    "react-webcam": "^7.0.1",
    "sweetalert2": "^11.4.24",
    "text-encoding": "^0.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7",
    "yup": "^0.32.11"
  }
}
