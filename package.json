{
  "name": "kemis-library",
  "version": "3.0.0-rc.0",
  "description": "Kemis package for creating forms, which mainly uses the 'primereact' library.",
  "homepage": "https://github.com/KEMIS-Systems/components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./styles": "./dist/styles/base.css",
    "./styles/base.css": "./dist/styles/base.css",
    "./styles/components": "./dist/styles/components.css",
    "./styles/components.css": "./dist/styles/components.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "postcss src/styles/components/components.css --dir dist/styles && npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/styles/base.css",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KEMIS-Systems/components.git"
  },
  "keywords": [
    "react",
    "components",
    "kemis",
    "form"
  ],
  "author": "KEMIS Softwware House | wmachado@kemis.com.br",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^3.2.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "axios": "^1.4.0",
    "caniuse-lite": "^1.0.30001767",
    "cep-promise": "^4.4.0",
    "clsx": "^2.1.1",
    "cpf-cnpj-validator": "^1.0.3",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react-canvas-draw": "^1.2.1",
    "react-dropzone": "^14.2.2",
    "react-hook-form": "^7.34.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^10.0.11",
    "react-international-phone": "^4.3.0",
    "react-webcam": "^7.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.1.3",
    "zod": "^3.22.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jsdom-global": "^3.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.15",
    "@types/react-canvas-draw": "^1.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^8.6.18",
    "text-encoding": "^0.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
